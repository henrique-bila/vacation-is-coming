# Flight provider — serpapi (default) or amadeus (enterprise BYOK)
FLIGHT_PROVIDER=serpapi

# SerpAPI — Google Flights (https://serpapi.com)
# Free tier: 250 searches/month. See docs/SETUP_SERPAPI.md
SERPAPI_API_KEY=

# Amadeus Enterprise (optional) — see docs/SETUP_AMADEUS.md
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=production

# WhatsApp — choose one provider: callmebot | twilio
WHATSAPP_PROVIDER=callmebot

# CallMeBot — see docs/SETUP_WHATSAPP.md
# 1) Save +34 621 062 163 and send: I allow callmebot to send me messages
# 2) Put phone (country code + number) and the APIKEY you received
# 3) Test: python -m src --test-whatsapp
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Twilio WhatsApp (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=

# Optional: only send if a price is at or below this amount
# PRICE_ALERT_MAX=
